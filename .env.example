# Copy to `.env.local` for local dev, and set the same two variables in your
# host's dashboard (Vercel → Settings → Environment Variables).
#
# ONLY these two reach the browser. Anything prefixed VITE_ is compiled into the
# public bundle, so NEVER put a service-role key, the Anthropic key, the YNAB
# token, or the Telegram token here — those live in Supabase Edge Function
# secrets / Vault and stay server-side (see CLAUDE.md).

# Supabase project URL, e.g. https://<project-ref>.supabase.co
VITE_SUPABASE_URL=

# Supabase ANON / publishable key — safe for the browser, RLS enforces access.
# This is NOT the service_role key.
VITE_SUPABASE_ANON_KEY=
